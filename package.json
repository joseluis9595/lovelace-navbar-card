  "repository": "git@github.com:joseluis9595/lovelace-navbar-card.git",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "tsc -b && NODE_ENV=production bun build src/navbar-card.ts --outfile=dist/navbar-card.js --target=browser",
    "lint": "biome check --write",
    "lint:check": "biome check",
    "format": "biome format --write src/**/*.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@open-wc/testing": "^5.0.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/bun": "1.4.2",
    "@vitest/coverage-v8": "5.0.3",
    "jsdom": "^30.1.1",
    "prettier": "^3.9.9",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@biomejs/biome": "^2.5.15",
    "@kipk/load-ha-components": "^1.0.3",
    "@open-wc/scoped-elements": "^3.0.10",
    "@open-wc/testing-helpers": "^3.0.1",
    "custom-card-helpers": "^2.0.0",
    "home-assistant-js-websocket": "^9.7.0",
    "lit": "^3.3.3"
  },
  "module": "index.ts"
}
